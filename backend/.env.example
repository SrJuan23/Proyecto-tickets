PORT=3000
NODE_ENV=development

# Base de datos: 'sqlite' (desarrollo) o 'mysql' (producción)
DB_CLIENT=sqlite
DB_SQLITE_PATH=./database/support_desk.sqlite

# Configuración MySQL (si se usa MySQL)
DB_HOST=localhost
DB_PORT=3306
DB_USER=root
DB_PASSWORD=tu_password
DB_NAME=support_desk_db
DB_SSL=false

# Seguridad JWT (CAMBIAR EN PRODUCCIÓN - mínimo 32 caracteres aleatorios)
JWT_SECRET=tu_clave_secreta_jwt_aqui
JWT_EXPIRES_IN=24h

# CORS - dominios permitidos (separados por coma)
CORS_ORIGIN=http://localhost:5173,http://localhost:3000

# ServiceNow
SERVICENOW_BASE_URL=https://instance.service-now.com/nav_to.do?uri=incident.do?sysparm_query=number=

# Seed de datos iniciales (solo true en desarrollo)
ENABLE_SEED=true
