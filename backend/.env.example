PORT=3000
NODE_ENV=production

# Base de datos PostgreSQL
DB_CLIENT=postgres
DATABASE_URL=postgresql://support:support@localhost:5432/support_desk

# Seguridad JWT (CAMBIAR EN PRODUCCIÓN - mínimo 32 caracteres aleatorios)
JWT_SECRET=cambia_esto_por_un_secreto_largo_y_aleatorio
JWT_EXPIRES_IN=24h

# CORS - dominios permitidos (separados por coma)
CORS_ORIGIN=http://localhost:5173,http://localhost:3000

# ServiceNow (URL base para apertura de incidentes)
SERVICENOW_BASE_URL=https://tu-instancia.service-now.com/nav_to.do?uri=incident.do?sysparm_query=number=

# Seed de datos iniciales (solo true en desarrollo)
ENABLE_SEED=false
